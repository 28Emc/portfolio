---
import { ArrowUp } from '@lucide/astro';
---

<button
  id="scroll-to-top"
  class="fixed bottom-8 right-8 p-3 rounded-full bg-accent text-white shadow-lg shadow-accent/20 translate-y-20 opacity-0 transition-all duration-300 z-50 hover:-translate-y-1 hover:shadow-xl active:scale-90 cursor-pointer"
  aria-label="Volver arriba"
>
  <ArrowUp size={24} aria-hidden="true" />
</button>

<script>
  const scrollTopBtn = document.getElementById('scroll-to-top');

  window.addEventListener('scroll', () => {
    const isVisible = window.scrollY > 400;
    scrollTopBtn?.classList.toggle('translate-y-20', !isVisible);
    scrollTopBtn?.classList.toggle('opacity-0', !isVisible);
    scrollTopBtn?.classList.toggle('translate-y-0', isVisible);
    scrollTopBtn?.classList.toggle('opacity-100', isVisible);
  });

  scrollTopBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>

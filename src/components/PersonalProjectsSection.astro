---
import { getImage } from 'astro:assets';
import { getI18NData } from '../utils/i18n';
import { Code2, Rocket, Building2, ChefHat } from '@lucide/astro';
import SectionHeader from './ui/SectionHeader.astro';
import Card from './ui/Card.astro';
import Badge from './ui/Badge.astro';

const lang = Astro.currentLocale || 'es';
const { personalProjects: ppData, ui } = getI18NData(lang);
const { personalProjects } = ppData;

const statusConfig: Record<string, { label: string }> = {
  mvp: { label: 'MVP' },
  development: { label: 'En desarrollo' },
  idea: { label: 'Idea' }
};

const projectIcons = [Rocket, Building2, ChefHat] as const;

const projectImages: Record<string, string> = {};

async function loadImages() {
  try {
    const sgcc = (await import('../assets/projects/SGCC.png')).default;
    const opt = await getImage({ src: sgcc, format: 'webp' });
    projectImages['SGCC'] = opt.src;
  } catch {}
  try {
    const transit = (await import('../assets/projects/TransitOne.png')).default;
    const opt = await getImage({ src: transit, format: 'webp' });
    projectImages['TransitOne Perú'] = opt.src;
  } catch {}
  try {
    const meal = (await import('../assets/projects/MealMind.png')).default;
    const opt = await getImage({ src: meal, format: 'webp' });
    projectImages['MealMind'] = opt.src;
  } catch {}
}
await loadImages();
---

<section id="personal-proyectos" class="section-padding" aria-labelledby="personal-header">
  <SectionHeader
    id="personal-header"
    tag={ui.sections.personalProj.tag}
    title={ui.sections.personalProj.title}
  />

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {personalProjects.map((project, index) => {
      const Icon = projectIcons[index] || Code2;
      const statusLabel = statusConfig[project.status]?.label || 'MVP';
      return (
        <div class="reveal-on-scroll" data-animation="fade-in" data-delay={index * 150}>
          <Card class="flex flex-col h-full overflow-hidden group hover:border-accent/40 border-dashed border-2 transition-all duration-300 tilt-card" padding="none">
            {projectImages[project.title] && (
              <div class="relative h-36 overflow-hidden bg-slate-100 dark:bg-slate-800">
                <img
                  src={projectImages[project.title]}
                  alt={project.title}
                  class="w-full h-full object-contain p-4 group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            )}

            <div class="p-6 flex-1 flex flex-col">
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="flex items-center gap-2">
                  <Icon size={18} class="text-accent shrink-0" aria-hidden="true" />
                  <h3 class="text-xl font-bold dark:text-white group-hover:text-accent transition-colors">{project.title}</h3>
                </div>
                <span class="shrink-0 text-[9px] font-bold px-2 py-0.5 rounded-full uppercase tracking-widest border border-amber-400/40 text-amber-600 dark:text-amber-400">
                  {statusLabel}
                </span>
              </div>

              <p class="text-sm text-slate-600 dark:text-slate-400 mb-5 leading-relaxed">
                {project.description}
              </p>

              <div class="mb-5 flex-1">
                <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter mb-3 flex items-center gap-1.5">
                  <Code2 size={12} aria-hidden="true" /> Arquitectura
                </h4>
                <ul class="space-y-2">
                  {project.architectureHighlights.map(h => (
                    <li class="text-xs text-slate-700 dark:text-slate-300 flex gap-2">
                      <span class="text-accent shrink-0 mt-0.5" aria-hidden="true">▸</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <ul class="flex flex-wrap gap-2 pt-4 border-t border-slate-100 dark:border-slate-800" aria-label={`Tecnologías de ${project.title}`}>
                {project.technologies.map(tech => (
                  <li>
                    <Badge variant="solid" class="bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 group-hover:border-accent/20 transition-all rounded-full">{tech}</Badge>
                  </li>
                ))}
              </ul>
            </div>
          </Card>
        </div>
      );
    })}
  </div>
</section>

<script>
  const initTilt = () => {
    const cards = document.querySelectorAll('.tilt-card');
    cards.forEach(card => {
      const cardEl = card as HTMLElement;
      const handleMove = (e: MouseEvent) => {
        const { left, top, width, height } = cardEl.getBoundingClientRect();
        const x = (e.clientX - left) / width;
        const y = (e.clientY - top) / height;
        const tiltX = (y - 0.5) * 10;
        const tiltY = (x - 0.5) * -10;
        cardEl.style.transform = `perspective(1000px) rotateX(${tiltX}deg) rotateY(${tiltY}deg) scale3d(1.02, 1.02, 1.02)`;
      };
      const handleLeave = () => {
        cardEl.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
      };
      cardEl.addEventListener('mousemove', handleMove);
      cardEl.addEventListener('mouseleave', handleLeave);
    });
  };
  initTilt();
  document.addEventListener('astro:after-swap', initTilt);
</script>

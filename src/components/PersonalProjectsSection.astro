---
import type { ImageMetadata } from 'astro';
import { getI18NData } from '../utils/i18n';
import { Code2, Rocket, Building2, ChefHat } from '@lucide/astro';
import SectionHeader from './ui/SectionHeader.astro';
import Card from './ui/Card.astro';
import Badge from './ui/Badge.astro';

const lang = Astro.currentLocale || 'es';
const { personalProjects: ppData, ui } = getI18NData(lang);
const { personalProjects } = ppData;

const statusConfig: Record<string, { label: string; color: string }> = {
  mvp: { label: 'MVP', color: 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400' },
  development: { label: 'En desarrollo', color: 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400' },
  idea: { label: 'Idea', color: 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400' }
};

const projectIcons = [Rocket, Building2, ChefHat] as const;

let sgccImg: ImageMetadata | undefined;
let transitOneImg: ImageMetadata | undefined;
let mealMindImg: ImageMetadata | undefined;

try {
  sgccImg = (await import('../assets/projects/SGCC.png')).default;
} catch {}
try {
  transitOneImg = (await import('../assets/projects/TransitOne.png')).default;
} catch {}
try {
  mealMindImg = (await import('../assets/projects/MealMind.png')).default;
} catch {}

const imageMap: Record<string, ImageMetadata | undefined> = {
  'SGCC': sgccImg,
  'TransitOne Perú': transitOneImg,
  'MealMind': mealMindImg,
};
---

<section id="personal-proyectos" class="section-padding" aria-labelledby="personal-header">
  <SectionHeader
    id="personal-header"
    tag={ui.sections.personalProj.tag}
    title={ui.sections.personalProj.title}
  />

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {personalProjects.map((project, index) => {
      const status = statusConfig[project.status] || statusConfig.mvp;
      const Icon = projectIcons[index] || Code2;
      return (
        <div class="reveal-on-scroll" data-animation="fade-in" data-delay={index * 150}>
          <Card class="flex flex-col h-full overflow-hidden group hover:border-accent/40 border-dashed border-2 transition-all duration-300" padding="none">
            {imageMap[project.title] && (
              <div class="relative h-40 overflow-hidden bg-slate-100 dark:bg-slate-800">
                <img
                  src={imageMap[project.title].src}
                  alt={project.title}
                  class="w-full h-full object-contain p-4 group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-white/60 dark:from-slate-950/60 to-transparent" aria-hidden="true"></div>
              </div>
            )}

            <div class="p-6 flex-1 flex flex-col">
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="flex items-center gap-2">
                  <Icon size={18} class="text-accent shrink-0" aria-hidden="true" />
                  <h3 class="text-xl font-bold dark:text-white group-hover:text-accent transition-colors">{project.title}</h3>
                </div>
                <span class={`shrink-0 text-[10px] font-bold px-2 py-1 rounded-full uppercase tracking-wider ${status.color}`}>
                  {status.label}
                </span>
              </div>

              <p class="text-sm text-slate-600 dark:text-slate-400 mb-5 leading-relaxed">
                {project.description}
              </p>

              <div class="mb-5 flex-1">
                <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter mb-3 flex items-center gap-1.5">
                  <Code2 size={12} aria-hidden="true" /> Arquitectura
                </h4>
                <ul class="space-y-2">
                  {project.architectureHighlights.map(h => (
                    <li class="text-xs text-slate-700 dark:text-slate-300 flex gap-2">
                      <span class="text-accent shrink-0 mt-0.5" aria-hidden="true">▸</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <ul class="flex flex-wrap gap-2 pt-4 border-t border-slate-100 dark:border-slate-800" aria-label={`Tecnologías de ${project.title}`}>
                {project.technologies.map(tech => (
                  <li>
                    <Badge variant="solid" class="bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 group-hover:border-accent/20 transition-all rounded-full">{tech}</Badge>
                  </li>
                ))}
              </ul>
            </div>
          </Card>
        </div>
      );
    })}
  </div>
</section>

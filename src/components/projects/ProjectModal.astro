---
import { getI18NData } from '../../utils/i18n';
import { X } from '@lucide/astro';

const lang = Astro.currentLocale || 'es';
const { ui } = getI18NData(lang);
---

<div
  id="project-modal"
  class="fixed inset-0 z-[300] bg-slate-950/90 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300 flex items-center justify-center p-4"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
>
  <div class="relative max-w-5xl w-full bg-white dark:bg-slate-900 border border-transparent dark:border-white/10 rounded-[2rem] overflow-hidden shadow-2xl translate-y-8 transition-transform duration-300">
    <button
      id="close-project-modal"
      class="absolute top-4 right-4 p-3 rounded-full bg-black/20 hover:bg-black/40 text-white backdrop-blur-md z-10 transition-colors cursor-pointer group"
      aria-label={ui.common.close}
    >
      <X size={24} aria-hidden="true" class="group-hover:rotate-90 transition-transform duration-300" />
    </button>
    <div class="flex items-center justify-center p-2 bg-slate-50 dark:bg-slate-950">
      <img id="modal-project-img" src="" alt={`${ui.sections.proj.title} Preview`} class="max-w-full max-h-[85vh] object-contain rounded-[1.5rem] shadow-xl" />
    </div>
  </div>
</div>

<style>
  #project-modal.active {
    opacity: 1;
    pointer-events: auto;
  }
  #project-modal.active > div {
    transform: translateY(0);
  }
</style>

<script>
  const setupModal = () => {
    const projectModal = document.getElementById('project-modal');
    const projectModalImg = document.getElementById('modal-project-img') as HTMLImageElement;
    const closeModalBtn = document.getElementById('close-project-modal');

    function openProjectModal(imageSrc: string) {
      if (!projectModal || !projectModalImg) return;
      projectModalImg.src = imageSrc;
      projectModal.classList.add('active');
      projectModal.removeAttribute('aria-hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeProjectModal() {
      if (!projectModal) return;
      projectModal.classList.remove('active');
      projectModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => { if (projectModalImg) projectModalImg.src = ''; }, 300);
    }

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest('.project-image-trigger');
      if (trigger) {
        e.preventDefault();
        e.stopPropagation();
        const imageSrc = trigger.getAttribute('data-image');
        if (imageSrc) openProjectModal(imageSrc);
      }
    });

    closeModalBtn?.addEventListener('click', closeProjectModal);
    projectModal?.addEventListener('click', (e) => {
      if (e.target === projectModal) closeProjectModal();
    });
    
    const escHandler = (e: KeyboardEvent) => {
      if (e.key === 'Escape') closeProjectModal();
    };
    document.addEventListener('keydown', escHandler);
  };

  setupModal();
  document.addEventListener('astro:after-swap', setupModal);
</script>

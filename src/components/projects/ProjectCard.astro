---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { getI18NData } from '../../utils/i18n';
import type { Project } from '../../types';
import { CheckCircle2, AlertCircle, Lightbulb, Star, Eye } from '@lucide/astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const lang = Astro.currentLocale || 'es';
const { ui } = getI18NData(lang);

const projectSlug = project.title.replace(/\s+/g, '-').toLowerCase();

// Dynamic image resolution
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/*.{jpeg,jpg,png,gif}');
let optimizedImageSrc = '';

if (project.picImg) {
  const imagePath = `../../assets/projects/${project.picImg}`;
  if (images[imagePath]) {
    const { default: metadata } = await images[imagePath]();
    const optimized = await getImage({ src: metadata, format: 'webp' });
    optimizedImageSrc = optimized.src;
  }
}
---

<Card class="flex flex-col h-full overflow-hidden group hover:border-accent ring-2 ring-accent/10 border-accent/20 hover:cursor-default transition-all duration-300 hover:shadow-2xl hover:shadow-accent/5 tilt-card" padding="none">
  <div class="p-8 flex-1">
    <div class="flex justify-between items-start mb-6">
      <div class="flex items-center gap-2">
        <Star size={16} class="text-accent fill-accent group-hover:scale-125 transition-transform" aria-hidden="true" />
        <h3 id={`project-title-${projectSlug}`} class="text-2xl font-bold dark:text-white group-hover:text-accent transition-colors">
          {project.title}
        </h3>
      </div>
      {optimizedImageSrc && (
        <button
          class="project-image-trigger p-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-400 hover:text-accent hover:bg-slate-200 dark:hover:bg-slate-700 transition-all cursor-pointer"
          data-image={optimizedImageSrc}
          aria-label={`${ui.common.viewPreview} ${project.title}`}
          title={ui.common.viewPreview}
        >
          <Eye size={20} aria-hidden="true" />
        </button>
      )}
    </div>

    <p class="text-slate-600 dark:text-slate-400 mb-8 leading-relaxed text-sm">
      {project.description}
    </p>

    <dl class="space-y-4 mb-4">
      {[
        { icon: AlertCircle, label: ui.common.problem, text: project.problem, color: "text-red-400" },
        { icon: Lightbulb, label: ui.common.solution, text: project.solution, color: "text-blue-400" },
        { icon: CheckCircle2, label: ui.common.result, text: project.result, color: "text-green-400" }
      ].map(({ icon: Icon, label, text, color }) => (
        <div class="flex gap-4">
          <dt class:list={["mt-1 shrink-0", color]} aria-hidden="true"><Icon size={16} /></dt>
          <div class="flex flex-col">
            <dt class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter">{label}</dt>
            <dd class="text-xs text-slate-700 dark:text-slate-300 font-medium">{text}</dd>
          </div>
        </div>
      ))}
    </dl>
  </div>

  <ul class="p-6 bg-slate-50 dark:bg-slate-800/20 border-t border-slate-100 dark:border-slate-800 flex flex-wrap gap-2" aria-label={`${ui.common.techs} ${project.title}`}>
    {project.technologies.map(tech => (
      <li>
        <Badge variant="solid" class="bg-white dark:bg-slate-900 rounded-full group-hover:border-accent/20 transition-all">{tech}</Badge>
      </li>
    ))}
  </ul>
</Card>

<script>
  /**
   * 3D Tilt Effect Manager
   * Applies perspective rotation on mouse move for project cards
   */
  const initTilt = () => {
    const cards = document.querySelectorAll('.tilt-card');
    
    cards.forEach(card => {
      const cardEl = card as HTMLElement;
      
      const handleMove = (e: MouseEvent) => {
        const { left, top, width, height } = cardEl.getBoundingClientRect();
        const x = (e.clientX - left) / width;
        const y = (e.clientY - top) / height;
        
        const tiltX = (y - 0.5) * 10;
        const tiltY = (x - 0.5) * -10;
        
        cardEl.style.transform = `perspective(1000px) rotateX(${tiltX}deg) rotateY(${tiltY}deg) scale3d(1.02, 1.02, 1.02)`;
      };

      const handleLeave = () => {
        cardEl.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
      };

      cardEl.addEventListener('mousemove', handleMove);
      cardEl.addEventListener('mouseleave', handleLeave);
    });
  };

  // Launch on init and after view transitions
  initTilt();
  document.addEventListener('astro:after-swap', initTilt);
</script>

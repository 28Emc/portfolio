---
import { projects } from '../data/projects';
import SectionHeader from './ui/SectionHeader.astro';
import ProjectCard from './projects/ProjectCard.astro';
import SimpleProjectCard from './projects/SimpleProjectCard.astro';
import ProjectModal from './projects/ProjectModal.astro';

const featuredProjects = projects.filter(p => p.isFeatured);
const otherProjects = projects.filter(p => !p.isFeatured);
---

<section id="proyectos" class="section-padding bg-slate-100/30 dark:bg-slate-900/10" aria-labelledby="projects-title">
  <SectionHeader 
    tag="Portafolio" 
    title="Proyectos Destacados" 
  />

  <div class="space-y-20">
    <!-- Featured Projects Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

    <!-- Secondary Projects Section -->
    <div>
      <h3 class="text-xl font-bold dark:text-white mb-8 border-l-4 border-slate-300 dark:border-slate-700 pl-4">
        Otros proyectos relevantes
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {otherProjects.map((project) => (
          <SimpleProjectCard project={project} />
        ))}
      </div>
    </div>
  </div>
</section>

<ProjectModal />

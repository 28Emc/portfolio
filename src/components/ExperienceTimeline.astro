---
import { getI18NData } from '../utils/i18n';
import { Briefcase } from '@lucide/astro';
import SectionHeader from './ui/SectionHeader.astro';
import Card from './ui/Card.astro';
import Badge from './ui/Badge.astro';

const lang = Astro.currentLocale || 'es';
const { experience: expData, ui } = getI18NData(lang);
const { experiences } = expData;
---

<section id="experiencia" class="section-padding" aria-labelledby="experiencia-header">
  <div class="flex flex-col md:flex-row gap-12">
    <div class="md:w-1/3">
      <SectionHeader 
        id="experiencia-header"
        tag={ui.sections.exp.tag} 
        title={ui.sections.exp.title} 
        description={ui.sections.exp.desc}
        centered={false}
      />
    </div>

    <div class="md:w-2/3 relative">
      <div class="absolute left-0 md:left-8 top-0 h-full w-[2px] bg-slate-200 dark:bg-slate-800 hidden sm:block" aria-hidden="true"></div>

      <ul class="space-y-12" aria-label="Línea de tiempo de experiencia profesional">
        {experiences.map((exp, index) => (
          <li class="reveal-on-scroll" data-animation="slide-up" data-delay={index * 150}>
            <article class="relative pl-0 sm:pl-20 group hover:cursor-default">
              <div class="absolute left-[-4px] sm:left-8 top-0 p-2 rounded-full border-4 border-white dark:border-slate-950 bg-slate-900 dark:bg-slate-800 text-white dark:text-accent z-10 hidden sm:block -translate-x-1/2 group-hover:scale-110 transition-transform duration-300" aria-hidden="true">
                <Briefcase size={16} />
              </div>

              <Card class="group-hover:shadow-md hover:border-accent group-hover:translate-x-1 transition-all">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                  <div>
                    <h3 class="text-xl font-bold dark:text-white group-hover:text-accent transition-colors">{exp.role}</h3>
                    <p class="text-accent font-semibold">{exp.company}</p>
                  </div>
                  <time class="text-xs font-bold px-3 py-1 bg-slate-100 dark:bg-slate-800 text-slate-500 rounded-full w-fit">
                    {exp.period}
                  </time>
                </div>

                <ul class="space-y-3 mb-6" aria-label={`Logros en ${exp.company}`}>
                  {exp.description.map(bullet => (
                    <li class="text-slate-600 dark:text-slate-400 text-sm flex gap-3">
                      <span class="text-accent" aria-hidden="true">•</span> {bullet}
                    </li>
                  ))}
                </ul>

                <ul class="flex flex-wrap gap-2" aria-label={`Tecnologías utilizadas en ${exp.company}`}>
                  {exp.technologies.map(tech => (
                    <li>
                      <Badge variant="solid" class="group-hover:bg-accent group-hover:text-white transition-colors">{tech}</Badge>
                    </li>
                  ))}
                </ul>
              </Card>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

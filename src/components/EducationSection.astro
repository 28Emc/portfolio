---
import { GraduationCap, Languages, Award, ShieldCheck } from '@lucide/astro';
import SectionHeader from './ui/SectionHeader.astro';
import Card from './ui/Card.astro';
import { educationItems, languageItems, certificationItems } from '../data/education';
---

<section id="educacion" class="section-padding bg-slate-100/30 dark:bg-slate-900/10" aria-labelledby="education-title">
  <div class="max-w-6xl mx-auto">
    <SectionHeader 
      tag="Formación" 
      title="Educación, Idiomas & Certificaciones" 
      id="education-title"
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div class="space-y-6">
        <h3 class="text-xl font-bold dark:text-white flex items-center gap-3">
          <GraduationCap class="text-accent" aria-hidden="true" /> Educación
        </h3>
        <ul class="space-y-6" aria-label="Lista de formación académica">
          {educationItems.map(item => (
            <li>
              <Card class="group hover:border-accent/40 transition-colors" padding="sm">
                <h4 class="text-lg font-bold dark:text-white mb-1 leading-tight group-hover:text-accent transition-colors">{item.degree}</h4>
                <p class="text-slate-500 dark:text-slate-400 font-medium text-sm">{item.institution}</p>
                <time class="text-slate-400 dark:text-slate-500 text-xs mt-2 uppercase font-bold tracking-widest">{item.period}</time>
              </Card>
            </li>
          ))}
        </ul>

        <h3 class="text-xl font-bold dark:text-white flex items-center gap-3 pt-6">
          <Languages class="text-accent" aria-hidden="true" /> Idiomas
        </h3>
        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-4" aria-label="Idiomas y niveles">
          {languageItems.map(lang => (
            <li>
              <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 text-center group hover:border-accent/40 transition-colors">
                <p class="font-bold dark:text-white text-sm group-hover:text-accent">{lang.name}</p>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">{lang.level}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-6">
        <h3 class="text-xl font-bold dark:text-white flex items-center gap-3">
          <Award class="text-accent" aria-hidden="true" /> Certificaciones
        </h3>
        <ul class="space-y-4" aria-label="Lista de certificaciones">
          {certificationItems.map(cert => (
            <li>
              <Card class="group hover:border-accent/40 transition-colors" padding="sm">
                <div class="flex items-start gap-4">
                  <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 text-accent shrink-0">
                    <ShieldCheck size={24} aria-hidden="true" />
                  </div>
                  <div>
                    <h4 class="text-lg font-bold dark:text-white mb-1 group-hover:text-accent transition-colors">{cert.name}</h4>
                    <p class="text-slate-500 dark:text-slate-400 font-medium text-sm">
                      <span class="sr-only">Emisor:</span> {cert.issuer} <br/>
                      <span class="sr-only">Identificador:</span> ID: {cert.id} <span class="mx-2 text-slate-300" aria-hidden="true">•</span> <time>{cert.date}</time>
                    </p>
                  </div>
                </div>
              </Card>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

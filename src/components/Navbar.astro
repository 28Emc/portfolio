---
import { Menu, Moon, Sun } from '@lucide/astro';
import { navItems } from '../data/info';
---

<nav
  class="fixed top-0 left-0 w-full z-50 bg-white/80 dark:bg-[var(--bg-dark)]/80 backdrop-blur-md border-b border-slate-200 dark:border-[var(--border-dark)] transition-all duration-300"
  role="navigation"
  aria-label="Navegación principal"
>
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="#hero" class="text-xl font-bold bg-gradient-to-r from-slate-900 to-slate-600 dark:from-white dark:to-slate-400 bg-clip-text text-transparent">
      EMC
    </a>

    <div class="hidden md:flex items-center gap-8">
      <ul class="flex items-center gap-8" role="list">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class="text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <button
        id="theme-toggle"
        class="ml-4 p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
        aria-label="Alternar modo oscuro"
      >
        <div class="block dark:hidden" aria-hidden="true"><Moon size={20} /></div>
        <div class="hidden dark:block" aria-hidden="true"><Sun size={20} /></div>
      </button>
    </div>

    <div class="flex items-center gap-2 md:hidden">
      <button
        id="theme-toggle-mobile"
        class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
        aria-label="Alternar modo oscuro"
      >
        <div class="block dark:hidden" aria-hidden="true"><Moon size={20} /></div>
        <div class="hidden dark:block" aria-hidden="true"><Sun size={20} /></div>
      </button>
      <button class="p-2" id="menu-toggle" aria-label="Abrir menú" aria-expanded="false">
        <Menu size={24} aria-hidden="true" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden absolute top-16 left-0 w-full bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 p-6 shadow-xl">
    <ul class="flex flex-col gap-4" role="list">
      {navItems.map(item => (
        <li>
          <a
            href={item.href}
            class="text-lg font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white block"
            onclick="document.getElementById('mobile-menu').classList.add('hidden')"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const themeToggle = document.getElementById('theme-toggle');
  const themeToggleMobile = document.getElementById('theme-toggle-mobile');

  menuToggle?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.toggle('hidden');
    menuToggle.setAttribute('aria-expanded', (!isHidden).toString());
  });

  const toggleTheme = () => {
    const isDark = document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('dark', !isDark);
    localStorage.setItem('theme', isDark ? 'light' : 'dark');
  };

  themeToggle?.addEventListener('click', toggleTheme);
  themeToggleMobile?.addEventListener('click', toggleTheme);
</script>

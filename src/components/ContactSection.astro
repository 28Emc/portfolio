---
import { Mail, Linkedin, Github, Phone } from '@lucide/astro';
import SectionHeader from './ui/SectionHeader.astro';
import Card from './ui/Card.astro';
import { socialLinks } from '../data/info';

const icons = {
  email: Mail,
  linkedin: Linkedin,
  github: Github,
  phone: Phone
};
---

<section id="contacto" class="section-padding" aria-labelledby="contact-title">
  <Card class="rounded-[32px] p-8 md:p-16 text-center max-w-5xl mx-auto border-accent/20" padding="none">
    <SectionHeader 
      tag="¿Hablamos?" 
      title="Impulsemos tu próximo producto juntos."
      centered={true}
      id="contact-title"
    />
    
    <p class="text-slate-600 dark:text-slate-400 text-lg mb-12 max-w-2xl mx-auto">
      Abierto a oportunidades como Desarrollador Full Stack para proyectos de alto impacto financiero y logístico.
    </p>

    <div class="flex flex-wrap justify-center gap-6">
      {socialLinks.map((link) => {
        const Icon = icons[link.platform];
        
        if (link.platform === 'email') {
          return (
            <a 
              href={link.href} 
              class="px-8 py-4 bg-accent text-white rounded-xl font-bold flex items-center gap-3 hover:scale-105 transition-transform"
              aria-label={`Enviar correo electrónico a ${link.href.replace('mailto:', '')}`}
            >
              <Icon size={20} aria-hidden="true" /> {link.href.replace('mailto:', '')}
            </a>
          );
        }

        return (
          <a 
            href={link.href} 
            target={link.href.startsWith('http') ? "_blank" : undefined}
            rel={link.href.startsWith('http') ? "noopener noreferrer" : undefined}
            class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:text-accent hover:border-accent transition-all"
            aria-label={`Perfil de ${link.label} de Edinson Medina Chinga`}
          >
            <Icon size={24} aria-hidden="true" />
          </a>
        );
      })}
    </div>
  </Card>
</section>

---
import { getI18NData } from '../utils/i18n';
import { Mail, Linkedin, Github, Phone } from '@lucide/astro';
import SectionHeader from './ui/SectionHeader.astro';
import Card from './ui/Card.astro';

const lang = Astro.currentLocale || 'es';
const { info, ui } = getI18NData(lang);
const { socialLinks } = info;

const icons = {
  email: Mail,
  linkedin: Linkedin,
  github: Github,
  phone: Phone
};
---

<section id="contacto" class="section-padding" aria-labelledby="contacto-header">
  <div class="reveal-on-scroll" data-animation="fade-in">
    <Card class="rounded-[32px] p-8 md:p-16 text-center max-w-5xl mx-auto border-accent/20 overflow-hidden" padding="none">
      <SectionHeader 
        id="contacto-header"
        tag={ui.sections.contact.tag} 
        title={ui.sections.contact.title}
        centered={true}
      />
      
      <p class="text-slate-600 dark:text-slate-400 text-lg mb-12 max-w-2xl mx-auto">
        {ui.sections.contact.desc}
      </p>

      <div class="flex flex-wrap justify-center gap-6">
        {socialLinks.map((link, index) => {
          const Icon = icons[link.platform as keyof typeof icons];
          
          if (link.platform === 'email') {
            return (
              <a 
                href={link.href} 
                class="px-8 py-4 bg-accent text-white rounded-xl font-bold flex items-center gap-3 hover:scale-105 active:scale-95 transition-all shadow-lg shadow-accent/20 reveal-on-scroll"
                data-animation="scale-up"
                data-delay={index * 100}
                aria-label={`${ui.hero.statusLabel}: ${link.href.replace('mailto:', '')}`}
              >
                <Icon size={20} aria-hidden="true" /> {link.href.replace('mailto:', '')}
              </a>
            );
          }

          return (
            <a 
              href={link.href} 
              target={link.href.startsWith('http') ? "_blank" : undefined}
              rel={link.href.startsWith('http') ? "noopener noreferrer" : undefined}
              class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:text-accent hover:border-accent hover:scale-105 active:scale-95 transition-all reveal-on-scroll"
              data-animation="scale-up"
              data-delay={index * 100}
              aria-label={`${link.label} profile`}
            >
              <Icon size={24} aria-hidden="true" />
            </a>
          );
        })}
      </div>
    </Card>
  </div>
</section>

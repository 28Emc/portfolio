---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import ScrollToTop from '../components/ScrollToTop.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title,
  description: customDescription,
  image = "/og-preview.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://28emc.github.io/portfolio/').href,
} = Astro.props;

const language = Astro.currentLocale || 'es';
const fullImageURL = new URL(image, Astro.site || 'https://28emc.github.io/portfolio/').href;

const defaultDescriptions: Record<string, string> = {
  es: "Backend Developer (Java & Spring Boot) con más de 5 años de experiencia en los sectores financiero y logístico. Especialista en Clean Architecture, DDD y Cloud.",
  en: "Backend Developer (Java & Spring Boot) with over 5 years of experience in the financial and logistics sectors. Specialist in Clean Architecture, DDD and Cloud.",
  it: "Backend Developer (Java & Spring Boot) con oltre 5 anni di esperienza nei settori finanziario e logistico. Specialista in Clean Architecture, DDD e Cloud."
};

const resolvedDescription = customDescription ?? defaultDescriptions[language] ?? defaultDescriptions.es;
---

<!doctype html>
<html lang={language} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}/emc_favicon.ico`} />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={resolvedDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={fullImageURL} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={resolvedDescription} />
    <meta property="twitter:image" content={fullImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <ClientRouter />

    <script is:inline>
      const themeInit = () => {
        const savedTheme = (() => {
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        })();
        document.documentElement.classList.toggle('dark', savedTheme === 'dark');
      };
      themeInit();
      document.addEventListener('astro:after-swap', themeInit);
    </script>
  </head>
  <body class="overflow-x-hidden bg-slate-50 text-slate-900 dark:bg-bg-dark dark:text-text-dark selection:bg-accent selection:text-white">
    <slot />
    <ScrollToTop />

    <script>
      /**
       * Manages all visual enhancements and intersections
       */
      const setupEffects = () => {
        // --- Scroll Reveal Manager ---
        const initScrollReveal = () => {
          const options = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const delay = parseInt(el.getAttribute('data-delay') || '0');
                
                if (delay > 0) {
                  setTimeout(() => el.classList.add('is-visible'), delay);
                } else {
                  el.classList.add('is-visible');
                }
                observer.unobserve(el);
              }
            });
          }, options);

          document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
        };

        // --- Scroll Spy Manager ---
        const initScrollSpy = () => {
          const options = { rootMargin: '-20% 0px -70% 0px' };
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                const id = entry.target.getAttribute('id');
                if (id) updateNavLinks(id);
              }
            });
          }, options);

          const updateNavLinks = (activeId: string) => {
            document.querySelectorAll('nav a, #mobile-menu a').forEach(link => {
              const isActive = link.getAttribute('href') === `#${activeId}`;
              link.classList.toggle('text-accent', isActive);
              link.classList.toggle('font-bold', isActive);
              isActive ? link.setAttribute('aria-current', 'page') : link.removeAttribute('aria-current');
            });
          };

          document.querySelectorAll('section[id]').forEach(section => observer.observe(section));
        };

        // Initialize all
        initScrollReveal();
        initScrollSpy();
      };

      // Lifecycle handling
      setupEffects();
      document.addEventListener('astro:after-swap', setupEffects);
    </script>
  </body>
</html>
